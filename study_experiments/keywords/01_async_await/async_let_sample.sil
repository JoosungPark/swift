    @_implements(AsyncIteratorProtocol, Failure) typealias __AsyncIteratorProtocol_Failure = Never
    init(current: Int = 0, limit: Int)
  }
  func makeAsyncIterator() -> Counter.AsyncIterator
  @available(iOS 18.0, tvOS 18.0, watchOS 11.0, visionOS 2.0, macOS 15.0, *)
  @_implements(AsyncSequence, Failure) typealias __AsyncSequence_Failure = Never
  init(limit: Int)
}

